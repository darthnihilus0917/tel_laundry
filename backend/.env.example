# Copy to .env (git-ignored) and fill in.

# Local PostgreSQL. The database is created automatically by `npm run db:migrate`.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/tel_laundry
DB_SSL=false

# Supabase later: use the project's connection string (pooler) and turn TLS on:
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DB_SSL=true

PORT=3001
# Comma-separated list of allowed browser origins (defaults to any):
# CORS_ORIGIN=http://localhost:5173
